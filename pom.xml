<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>lan.chaos</groupId>
    <artifactId>chaos-tcp-over-websockets</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>chaos-tcp-over-websockets</name>
    <url>https://github.com/xieqiansong/chaos-tcp-over-websockets</url>
    <description>基于 Netty 的 TCP over WebSocket 隧道工具（参考 Tcp_Over_websockets 改造的 client/server 模式）</description>

    <modules>
        <module>chaos-tcp-over-websockets-v1</module>
        <module>chaos-tcp-over-websockets-v2</module>
        <module>chaos-tcp-over-websockets-benchmark</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>8</java.version>
        <netty.version>4.1.115.Final</netty.version>
        <commons.collections4.version>4.4</commons.collections4.version>
        <lombok.version>1.18.42</lombok.version>
        <jmh.version>1.37</jmh.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <hutool.version>5.8.46</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${commons.collections4.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
